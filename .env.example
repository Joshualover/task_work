# ============================================================================
# 环境变量示例：复制为 .env（本地）或 .env.local（会被 git 忽略）后按需修改
#   cp .env.example .env
# ============================================================================

# ---- 日志 ----
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ---- AI 密钥加密 ----
# AI 设置中 apiKey / imageApiKey 的静态加密密钥（>= 16 字符，AES-256-GCM）。
# 留空则明文存储（仅建议本地开发）；生产环境务必配置为强随机值。
AI_SETTING_ENCRYPTION_KEY=

# ---- 请求体大小上限（图片识别 base64 需要，默认 12mb）----
# BODY_SIZE_LIMIT=12mb

# ============================================================================
# 独立部署（NAS / 自有服务器，脱离妙搭平台）—— 详见 DEPLOY.md
# ============================================================================
# PostgreSQL 连接串（平台变量名）
# SUDA_DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/task_work
# 平台 SDK 启动必填，占位即可
# FORCE_AUTHN_INNERAPI_DOMAIN=http://127.0.0.1:9
# 固定用户身份（单家庭自用）
# STANDALONE_USER_ID=nas
# STANDALONE_USER_NAME=家长
# 关闭平台网关的 CSRF 校验（独立部署必设，否则接口 403）
# ENABLE_CSRF=false
# 监听地址/端口（用反代时 127.0.0.1；直连时 0.0.0.0）
# SERVER_HOST=127.0.0.1
# SERVER_PORT=3000
# 页面目录（默认 <工作目录>/dist/client）
# VIEWS_DIR=/opt/task_work/dist/client

# ============================================================================
# 平台沙箱 / 本地开发（由平台或 scripts/dev-local.sh 注入，一般无需手填）
# ============================================================================
# MIAODA_APP_TYPE=3
# MIAODA_LOCAL_DEV=1
# SUDA_WEBUSER={"user_id":"local-dev-user","app_id":"local"}
# CLIENT_BASE_PATH=/
# CLIENT_DEV_PORT=8080

# ---- Vue SFC 支持（vite.config.ts 已内置插件，通常无需设置）----
# NODE_OPTIONS=--require ./vue-patch.cjs
