# ============================================================================
# 环境变量示例：复制为 .env（本地）或 .env.local（会被 git 忽略）后按需修改
#   cp .env.example .env
# ============================================================================

# ---- 日志 ----
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ---- AI 密钥加密 ----
# AI 设置中 apiKey / imageApiKey 的静态加密密钥（>= 16 字符，AES-256-GCM）。
# 留空则明文存储（仅建议本地开发）；生产环境务必配置为强随机值。
AI_SETTING_ENCRYPTION_KEY=

# ---- 请求体大小上限（图片识别 base64 需要，默认 12mb）----
# BODY_SIZE_LIMIT=12mb

# ---- 以下变量通常由平台注入，本地开发参考 README ----
# SUDA_DATABASE_URL=postgres://u:p@127.0.0.1:5432/db
# FORCE_AUTHN_INNERAPI_DOMAIN=http://127.0.0.1:9
# MIAODA_APP_TYPE=3
# MIAODA_LOCAL_DEV=1
# SUDA_WEBUSER={"user_id":"local-dev-user","app_id":"local"}
# CLIENT_BASE_PATH=/
# SERVER_PORT=3000
# CLIENT_DEV_PORT=8080

# ---- Vue SFC 支持（vite.config.ts 已内置插件，通常无需设置）----
# NODE_OPTIONS=--require ./vue-patch.cjs
